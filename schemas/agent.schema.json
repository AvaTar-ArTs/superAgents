{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/AvaTar-ArTs/superAgents/blob/main/schemas/agent.schema.json",
  "title": "SuperAgents Agent",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "name", "description", "tags", "capabilities", "skills", "source", "approval"],
  "properties": {
    "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]+$"},
    "name": {"type": "string", "minLength": 1},
    "description": {"type": "string", "minLength": 1},
    "tags": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "capabilities": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "skills": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "source": {"type": "string", "minLength": 1},
    "approval": {"enum": ["advisory", "approval_required", "restricted"]}
  }
}
